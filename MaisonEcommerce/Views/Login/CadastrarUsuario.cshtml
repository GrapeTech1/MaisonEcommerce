@model MaisonEcommerce.Models.Usuario
<link href="~/css/CadastroUsuario.css" rel="stylesheet" />

<div class="container-cadastro">
    <!-- Lado da imagem -->
	<div class="lado-imagem"><img src="~/image/imagentelacadastrologin.png" /></div>

    <!-- Lado do formulario -->
    <div class="lado-formulario">
        <h2>Crie a sua Conta</h2>
        <hr />

        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }

        <form asp-action="CadastrarUsuario">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label">Digite o seu nome de usuário:</label>
                <input asp-for="Nome" required maxlength="50" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label">Email:</label>
                <input asp-for="Email" required maxlength="50" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Senha" class="control-label">Senha:</label>
                <input asp-for="Senha" required maxlength="50" class="form-control" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmarSenha" class="control-label">Confirmar Senha:</label>
                <input asp-for="ConfirmarSenha" required maxlength="50" class="form-control" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>

            <div class="botoes">
                <a asp-controller="Login" asp-action="Login" class="btn-voltar">Voltar</a>
                <button type="submit" class="btn-cadastrar">Cadastrar</button>
            </div>
        </form>
    </div>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background-color: #1E1E1E;
        height: 100%;
        overflow: hidden; /* remove barra de rolagem */
    }

    .container-cadastro {
        display: flex;
        height: 100vh;
        width: 100%;
    }

    .lado-imagem {
        flex: 1;
        background-image: url('/imagens/imagentelacadastrologin.png');
        background-size: cover;
        background-position: center;
    }

    .lado-formulario {
        flex: 1;
        background-color: #000;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 40px;
        color: white;
    }

        .lado-formulario h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 32px;
            letter-spacing: 2px;
        }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        margin-bottom: 6px;
    }

    input {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 10px;
        background-color: #E5DADA;
        color: #000;
        font-size: 14px;
    }

    .botoes {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-voltar {
        background-color: white;
        color: black;
        border: 1px solid black;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: bold;
    }

    .btn-cadastrar {
        background-color: #A87454;
        color: white;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-cadastrar:hover {
            background-color: #8c5d43;
        }

    .btn-voltar:hover {
        background-color: #f0f0f0;
    }
</style>
