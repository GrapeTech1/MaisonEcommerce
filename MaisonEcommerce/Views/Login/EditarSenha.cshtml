@model MaisonEcommerce.Models.Usuario;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo">Redefinir de Senha</h1>
<hr />

<div class="row">
    @{
        ViewBag.OcultarNavbar = true;
    }

    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }

        <form asp-action="EditarSenha" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdUsuario" class="form-control" />
                <span asp-validation-for="IdUsuario" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" required class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Senha" class="control-label">Senha</label>
                <input asp-for="Senha" required class="form-control" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmarSenha" class="control-label">Confirmar Senha</label>
                <input asp-for="ConfirmarSenha" required class="form-control" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>

            <div class="captcha flex-column text-center bg-dark" id="captcha">
                <h6>Utilize as setas para rotacionar a imagem e coloque ela na direção em que a mão está apontando.</h6>

                <div class="alert alert-danger d-none" id="erro">Imagem rotacionada para o lado errado, por favor tente novamente.</div>

                <img src="~/image/captcha/mao2.png" width="30%" height="auto" />

                <input type="button" id="anterior" value="<" onclick="anteriorImg()" />
                <img src="~/image/captcha/img1.png" width="30%" height="auto" id="imagens" />
                <input type="button" id="depois" value=">" onclick="proximoImg()" />
                <br />

                <input type="button" class="btn btn-primary" value="Confirmar" id="cinfirmarCaptcha" onclick="confirmarCaptcha()" />
            </div>

            <div class="d-none text-center" id="sucesso">
                <div class="alert alert-success">Captcha realizado com sucesso.</div>
                <input type="button" class="btn btn-primary" disabled value="Confirmar" id="captcha" />
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Redefinir" class="btn btn-primary" />
                </div>

                <div class="form-group">
                    <a asp-action="Login" class="btn btn-success">Cancelar</a>
                </div>
            </div>
        </form>
    </div>
</div>