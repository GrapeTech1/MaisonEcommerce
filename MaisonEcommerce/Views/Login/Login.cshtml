@model MaisonEcommerce.Models.Usuario

@{
    Layout = null;
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-form-wrapper">
        <form asp-action="Login" method="post" class="login-form">
            <h2 class="login-title">Login</h2>

            <label for="email">Email</label>
            <input type="email" name="email" id="email" required class="input-field" />

            <label for="senha">Senha</label>
            <input type="password" name="senha" id="senha" required class="input-field" />

            <button type="submit" class="btn-login">ENTRAR</button>

            <a href="/Cliente/CadastrarCliente" class="cadastro-link">Cadastre-se aqui</a>
        </form>
    </div>

    <div class="image-side">
    </div>
</div>
