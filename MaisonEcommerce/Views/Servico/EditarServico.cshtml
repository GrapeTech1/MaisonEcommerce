@model MaisonEcommerce.Models.Servico;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo">Editar Serviço</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }

        <form asp-action="EditarServico" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdServico" class="form-control"/>
                <span asp-validation-for="IdServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" required oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" required oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" required oninput="decimal(this)" maxlength="6" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

             <div class="btn-group">
                <input type="submit" value="Alterar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-success">Voltar</a>
            </div>
        
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>