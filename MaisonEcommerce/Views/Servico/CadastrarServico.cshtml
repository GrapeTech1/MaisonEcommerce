@model MaisonEcommerce.Models.Servico;

<h1 class="titulo-ser">Cadastrar Serviços</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }
        <form asp-action="CadastrarServico">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Nome" class="tex-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Descricao" class="tex-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" oninput="decimal(this)" maxlength="6" class="form-control" />
                <span asp-validation-for="Preco" class="tex-danger"></span>
            </div>
            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Cadastrar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>