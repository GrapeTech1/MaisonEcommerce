@model IEnumerable<MaisonEcommerce.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-controller="Produto" asp-action="CadastrarProduto" class="btn btn-primary">Cadastrar Produto</a>
</p>

@if (ViewBag.cadastro != null)
{
    <div class="alert alert-success">@ViewBag.cadastro</div>
}

@if (TempData["Erro"]!= null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Foto</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th>Quantidade</th>
                <th>Preço</th>
                <th>Data de Cadastro</th>
                <th>Data de Modificação</th>
                <th class="text-center">Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var produto in Model)
            {
                <tr>
                    <td>@produto.IdProduto</td>
                    <td>
                        @if (produto.Foto != null && !string.IsNullOrEmpty(produto.TipoFoto))
                        {
                            <img src="@Url.Action("ObterFotoProduto", "Produto", new {id = produto.IdProduto})"
                                 alt="Foto do Produto"
                                 style="width: 100px; height: 100px; object-fit: cover;" />
                        }

                        else
                        {
                            <span>Sem Foto</span>
                        }
                    </td>
                    <td>@produto.Nome</td>
                    <td>@produto.Descricao</td>
                    <td>@produto.Quantidade</td>
                    <td>@produto.Preco</td>
                    <td>@produto.DataCadastro</td>

                    @if (produto.DataAtualizacao != produto.DataCadastro)
                    {
                        <td>@produto.DataAtualizacao</td>
                    }

                    else
                    {
                        <td class="text-center alert alert-warning"> Não foi Modificado </td>
                    }

                    <td class="text-center">
                        <a asp-controller="Produto" asp-action="EditarProduto" asp-route-id="@produto.IdProduto" class="btn btn-sm btn-warning">Editar</a>
                        <span>|</span>
                        <a asp-controller="Produto" asp-action="ExcluirProduto" asp-route-id="@produto.IdProduto"
                           onclick="return confirm('Deseja realmente Excluir este produto?')" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

else
{
    <p>Nenhum produto cadastrado.</p>
}