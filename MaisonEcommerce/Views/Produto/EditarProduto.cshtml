@model MaisonEcommerce.Models.Produto;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo">Editar Produto</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }
                   <form asp-action="EditarProduto" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="IdProduto" />

                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Descricao" class="control-label"></label>
                    <input asp-for="Descricao" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Quantidade" class="control-label"></label>
                    <input asp-for="Quantidade" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Preco" class="control-label"></label>
                    <input asp-for="Preco" class="form-control" />
                </div>

                <div class="form-group">
                    <label for="fotoProduto" class="control-label">Foto do Produto</label>
                    <input type="file" id="fotoProduto" name="fotoProduto" class="form-control" accept="image/*" />
                </div>

                <div class="btn-group">
                    <input type="submit" value="Alterar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </form>

    </div>
</div>