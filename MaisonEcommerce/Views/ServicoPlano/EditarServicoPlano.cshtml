@model MaisonEcommerce.Models.Servico_Plano;

<h1 class="titulo-servicoplano">Editar Servico Plano</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="EditarServicoPlano" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdServicoPlano" class="form-control" />
                <span asp-validation-for="IdServicoPlano" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdServico" class="control-label">Cliente</label>
                <select asp-for="IdServico" class="form-control" asp-items="ViewBag.Clientes">
                </select>
                <span asp-validation-for="IdServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdPlano" class="control-label">Serviço</label>
                <select asp-for="IdPlano" class="form-control" asp-items="ViewBag.Servicos">
                </select>
                <span asp-validation-for="IdPlano" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Alterar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>