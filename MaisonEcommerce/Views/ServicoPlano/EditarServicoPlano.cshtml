@model MaisonEcommerce.Models.Servico_Plano;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo">Editar Servico Plano</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        @if (ViewData["Mensagem"] != null)
        {
            <div class="@ViewData["Classe"]">@ViewData["Mensagem"]</div>
        }

        <form asp-action="EditarServicoPlano" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdServicoPlano" class="form-control" />
                <span asp-validation-for="IdServicoPlano" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomeServico" class="control-label">Serviço</label>
                <select asp-for="NomeServico" class="form-control">

                    @if (ViewBag.servicos != null)
                    {
                        @foreach (var item in ViewBag.servicos)
                        {
                            <option value="@item.IdServico">@item.Nome</option>
                        }
                    }

                </select>
                <span asp-validation-for="IdServico" class="text-danger"></span>
            </div>

                <div class="form-group">
                    <label asp-for="NomePlano" class="control-label">Plano</label>
                    <select asp-for="NomePlano" class="form-control">

                        @if (ViewBag.servicos != null)
                        {
                            @foreach (var item in ViewBag.planos)
                            {
                                <option value="@item.IdPlano">@item.Nome</option>
                            }
                        }

                    </select>
                    <span asp-validation-for="NomePlano" class="text-danger"></span>
                </div>

        <div class="btn-group">
                <input type="submit" value="Alterar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-success">Voltar</a>
            </div>
        </form>
    </div>
</div>