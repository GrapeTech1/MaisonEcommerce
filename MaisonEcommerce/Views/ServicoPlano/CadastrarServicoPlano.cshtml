@model MaisonEcommerce.Models.Servico_Plano
<link href="~/css/CadastroServicoPlano.css" rel="stylesheet" />

<div class="pagina-centro">
    <div class="container-servicoplano">
        <h1 class="titulo">Cadastrar Serviço Plano</h1>
        <hr />

        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }

        <form asp-action="CadastrarServicoPlano" class="form-servicoplano">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NomeServico" class="control-label">Plano</label>
                <select asp-for="NomeServico" class="form-control">
                    @if (ViewBag.servicos != null)
                    {
                        @foreach (var item in ViewBag.servicos)
                        {
                            <option value="@item.IdServico">@item.Nome</option>
                        }
                    }
                </select>
                <span asp-validation-for="NomeServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomePlano" class="control-label">Serviço</label>
                <select asp-for="NomePlano" class="form-control">
                    @if (ViewBag.planos != null)
                    {
                        @foreach (var item in ViewBag.planos)
                        {
                            <option value="@item.IdPlano">@item.Nome</option>
                        }
                    }
                </select>
                <span asp-validation-for="IdPlano" class="text-danger"></span>
            </div>

            <div class="form-buttons">
                <a asp-action="Index" class="btn-voltar">Voltar</a>
                <input type="submit" value="Cadastrar" class="btn-cadastrar" />
            </div>
        </form>
    </div>
</div>

<style>

    /* Reset */
    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        background-color: #000;
        font-family: Arial, sans-serif;
        color: white;
        overflow: hidden;
    }

    /* Centralização da página */
    .pagina-centro {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100%;
    }

    /* Container do formulário */
    .container-servicoplano {
        width: 400px;
        padding: 30px;
        background-color: #000;
        border-radius: 10px;
        box-shadow: 0px 0px 10px #222;
    }

    /* Título */
    .titulo {
        text-align: center;
        font-size: 24px;
        margin-bottom: 30px;
    }

    /* Estilização do formulário */
    .form-servicoplano .form-group {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
    }

    .form-servicoplano label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .form-servicoplano select {
        padding: 10px;
        border: none;
        border-radius: 6px;
        background-color: #fff;
        color: #000;
    }

    /* Botões */
    .form-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 25px;
    }

    .btn-voltar,
    .btn-cadastrar {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-voltar {
        background-color: white !important;
        color: #000 !important;
    }

    .btn-cadastrar {
        background-color: #8B5E3C !important;
        color: white !important;
    }

        .btn-voltar:hover,
        .btn-cadastrar:hover {
            opacity: 0.85;
        }

</style>