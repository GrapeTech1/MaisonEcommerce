@model MaisonEcommerce.Models.Servico_Plano;


<h1 class="titulo-servicoplano">Cadastrar Serviço Plano</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }
        <form asp-action="CadastrarServicoPlano">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <div class="form-group">
                <label asp-for="NomeServico" class="control-label">Plano</label>
                <select asp-for="NomeServico" class="form-control">

                    @if (ViewBag.servicos != null)
                    {
                        @foreach (var item in ViewBag.servicos)
                        {
                            <option value="@item.IdServico">@item.Nome</option>
                        }
                    }

                </select>
                <span asp-validation-for="NomeServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomePlano" class="control-label">Serviço</label>
                <select asp-for="NomePlano" class="form-control">

                    @if (ViewBag.planos != null)
                    {
                        @foreach (var item in ViewBag.planos)
                        {
                            <option value="@item.IdPlano">@item.Nome</option>
                        }
                    }

                </select>
                <span asp-validation-for="IdPlano" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Cadastrar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>