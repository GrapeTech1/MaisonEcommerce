@model IEnumerable<MaisonEcommerce.Models.Servico_Plano>

<link href="~/css/IndexSePla.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Serviços nos Planos";
}

<h1 style="font-weight: bold; text-align: center;" >@ViewData["Title"]</h1>

<p>
    <a asp-controller="ServicoPlano" asp-action="CadastrarServicoPlano" class="btn btn-primary">Adicionar Serviço no Plano</a>
</p>

@if (ViewData["Mensagem"] != null)
{
    <div class="@ViewData["Classe"]">@ViewData["Mensagem"]</div>
}

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table custom-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome do Serviço</th>
                <th>Nome do Plano</th>
                <th>Data da Adição</th>
                <th>Data de Modificação</th>

                <th class="text-center">Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var servicoPlano in Model)
            {
                <tr>
                    <td>@servicoPlano.IdServicoPlano</td>
                    <td>@servicoPlano.NomeServico</td>
                    <td>@servicoPlano.NomePlano</td>
                    <td>@servicoPlano.DataAtualizacao</td>

                    @if (servicoPlano.DataAdicao == servicoPlano.DataAtualizacao)
                    {
                        <td class="text-center alert alert-info"> Não foi Modificado </td>
                    }

                    else
                    {
                        <td>@servicoPlano.DataAdicao</td>
                    }

                    <td class="text-center">
                        <a asp-controller="ServicoPlano" asp-action="EditarServicoPlano" asp-route-id="@servicoPlano.IdServicoPlano" class="btn btn-sm btn-warning">Editar</a>
                        <span>|</span>
                        <a asp-controller="ServicoPlano" asp-action="ExcluirServicoPlano" asp-route-id="@servicoPlano.IdServicoPlano"
                           onclick="return confirm('Deseja realmente Excluir este ServicoPlano?')" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

else
{
    <p>Nenhum serviço adicionado ao(s) plano(s).</p>
}