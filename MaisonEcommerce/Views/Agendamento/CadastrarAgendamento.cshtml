@model MaisonEcommerce.Models.Agendamento;


<h1 class="titulo-agen">Cadastrar Agendamento</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }
        <form asp-action="CadastrarAgendamento">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <div class="form-group">
                <label asp-for="IdCliente_Agen" class="control-label">Cliente</label>
                <select asp-for="IdCliente_Agen" class="form-control" asp-items="ViewBag.Clientes">
                </select>
                <span asp-validation-for="IdCliente_Agen" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IdServico_Agen" class="control-label">Serviço</label>
                <select asp-for="IdServico_Agen" class="form-control" asp-items="ViewBag.Servicos">
                </select>
                <span asp-validation-for="IdServico_Agen" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataHora" class="control-label">Data e Hora</label>
                <input asp-for="DataHora" class="form-control" type="datetime-local" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Cadastrar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>