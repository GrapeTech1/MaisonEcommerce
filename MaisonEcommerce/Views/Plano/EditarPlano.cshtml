@model MaisonEcommerce.Models.Plano;

<h1 class="titulo-plan">Editar Plano</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="EditarPlano" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdPlano" class="form-control" />
                <span asp-validation-for="IdPlano" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DuracaoPlano" class="control-label"></label>
                <input asp-for="DuracaoPlano" class="form-control" />
                <span asp-validation-for="DuracaoPlano" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Preco" class="control-label"></label>
                <input asp-for="Preco" class="form-control" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Alterar" class="btn btn-primary" />
                </div>

                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>