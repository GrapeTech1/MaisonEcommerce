@model MaisonEcommerce.Models.Plano;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo>Editar Plano</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }

        <form asp-action="EditarPlano" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdPlano" class="form-control" />
                <span asp-validation-for="IdPlano" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" disabled class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" required oninput="texto(this)" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Duracao" class="control-label"></label>
                <select asp-for="Duracao" class="form-control">

                    <option value="1 mes">1 mês</option>
                    <option value="3 meses">3 meses</option>
                    <option value="6 meses">6 meses</option>
                    <option value="1 ano">1 ano</option>

                </select>
                <span asp-validation-for="Duracao" class="text-danger"></span>
            </div>

            <div class="btn-group">
                <input type="submit" value="Alterar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-success">Voltar</a>
            </div>
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>