@model IEnumerable<MaisonEcommerce.Models.Agendamento>
<link href="~/css/IndexAgen.css" rel="stylesheet" />

@{
    ViewData["Title"] = "Agendamentos";
}

<h1 style="font-weight: bold; text-align: center;" >@ViewData["Title"]</h1>

<p>
    <a asp-controller="Agenda" asp-action="CadastrarAgen" class="btn btn-primary">Cadastrar Agendamento</a>
</p>

@if (ViewData["Mensagem"] != null)
{
    <div class="@ViewData["Classe"]">@ViewData["Mensagem"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table custom-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>CPF do Cliente</th>
                <th>Nome do Cliente</th>
                <th>Nome do Serviço</th>
                <th>Data e hora do agendamento</th>
                <th>Data de Cadastro</th>
                <th>Data de Modificação</th>

                <th class="text-center">Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var agendamento in Model)
            {
                <tr>
                    <td>@agendamento.IdAgendamento</td>
                    <td>@agendamento.CPF</td>
                    <td>@agendamento.NomeCliente</td>
                    <td>@agendamento.NomeServico</td>
                    <td>@agendamento.DataHora</td>
                    <td>@agendamento.DataCadastro</td>

                    @if (agendamento.DataCadastro == agendamento.DataAtualizacao)
                    {
                        <td class="alert-info">Não foi modificado</td>
                    }

                    else
                    {
                        <td>@agendamento.DataAtualizacao</td>
                    }


                    <td class="text-center">
                        <a asp-controller="Agenda" asp-action="EditarAgenda" asp-route-id="@agendamento.IdAgendamento" class="btn btn-sm btn-warning">
                            <img src="~/image/editar.png" alt="Editar" width="20" height="20" />
                        </a>
                        <span style="padding: 0 5px;">|</span>
                        <a asp-controller="Agenda" asp-action="EditarAgenda" asp-route-id="@agendamento.IdAgendamento"
                           onclick="return confirm('Deseja realmente Excluir este Agendamento? Os seus agendamentos serão deletados')" class="btn btn-sm btn-danger">
                            <img src="~/image/lixeira.png" alt="Excluir" width="20" height="20" />
                            </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

else
{
    <p>Nenhum serviço agendado.</p>
}