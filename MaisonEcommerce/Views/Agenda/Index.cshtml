@model IEnumerable<MaisonEcommerce.Models.Agendamento>

<p>
    <a asp-controller="Agendamento" asp-action="CadastrarAgendamento" class="btn btn-primary">Cadastrar Agendamento</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

<table class="table custom-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdAgendamento)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.IdCliente_Agen)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.IdServico_Agen)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataCadastro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataAtualizacao)
            </th>

            <th class="text-center">Ação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdAgendamento)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.IdCliente_Agen)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.IdServico_Agen)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataCadastro)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataAtualizacao)
                </td>
                <td class="text-center">
                    <a asp-controller="Agendamento" asp-action="EditarAgendamento" asp-route-id="@item.IdAgendamento" class="btn btn-sm btn-warning">Editar</a>
                    <span>|</span>
                    <a asp-controller="Agendamento" asp-action="ExcluirAgendamento" asp-route-id="@item.IdAgendamento"
                       onclick="return confirm('Deseja realmente Excluir este Agendamento?')" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>