@model MaisonEcommerce.Models.Agendamento;
@using MaisonEcommerce.Repositorio;
@using MaisonEcommerce.Controllers;

<h1 class="titulo-agen">Editar Agendamento</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        
        @if (ViewData["Mensagem"] != null)
        {
            <div class="@ViewData["Classe"]">@ViewData["Mensagem"]</div>
        }

        <form asp-action="EditarAgenda" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <input type="hidden" asp-for="IdAgendamento" class="form-control" />
                <span asp-validation-for="IdAgendamento" class="text-danger"></span>
            </div>

              <div class="form-group">
                  <label asp-for="CPF" class="control-label">CPF do cliente:</label>
                  <input list="clientes" asp-for="CPF" />
                  <datalist id="clientes">
                      @if(ViewBag.clientes != null)
                      {
                          @foreach (var item in ViewBag.clientes)
                          {
                              <option value="@item.CPF"></option>
                          }
                      }
                    
                  </datalist>

                  <span asp-validation-for="CPF" class="text-danger"></span>
              </div>


            <div class="form-group">
                <label asp-for="NomeServico" class="control-label">Serviço:</label>
                <select asp-for="NomeServico">
                    @if(ViewBag.servicos != null)
                    {
                        @foreach (var item in ViewBag.servicos)
                        {
                            <option value="@item.IdServico">@item.Nome</option>
                        }
                    }
                    
                </select>

                <span asp-validation-for="NomeServico" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DataHora" class="control-label">Escolha a data e hora do atendimento:</label>
                <input asp-for="DataHora" class="form-control" type="datetime-local" value="2025-06-23T17:00" min="2025-06-23T00:00" max="2025-12-24T00:00" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Alterar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>