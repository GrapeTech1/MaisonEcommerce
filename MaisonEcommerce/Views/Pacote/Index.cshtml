@model IEnumerable<MaisonEcommerce.Models.Pacote>

<p>
    <a asp-controller="Pacote" asp-action="CadastrarPacote" class="btn btn-primary">Cadastrar Pacote</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

<table class="table custom-table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome do Pacote</th>
            <th>Descrição</th>
            <th>Preço</th>
            <th>Data de Cadastro</th>
            <th>Data de Modificação</th>

            <th class="text-center">Ação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pacote in Model)
        {
            <tr>
                <td>@pacote.IdPacote</td>
                <td>@pacote.Nome</td>
                <td>@pacote.Descricao</td>
                <td>@pacote.Preco</td>
                <td>@pacote.DataCadastro</td>

                @if (pacote.DataCadastro == pacote.DataAtualizacao)
                {
                    <td class="alert-info">Não foi modificado</td>
                }

                else
                {
                    <td>@pacote.DataAtualizacao</td>
                }

                <td class="text-center">
                    <a asp-controller="Pacote" asp-action="EditarPacote" asp-route-id="@pacote.IdPacote" class="btn btn-sm btn-warning">Editar</a>
                    <span>|</span>
                    <a asp-controller="Pacote" asp-action="ExcluirPacote" asp-route-id="@pacote.IdPacote"
                       onclick="return confirm('Deseja realmente Excluir este pacote?')" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>