@model IEnumerable<MaisonEcommerce.Models.Pacote>

<link href="~/css/IndexPaco.css" rel="stylesheet" />


@{
    ViewData["Title"] = "Pacotes";
}

<h1 style="font-weight: bold; text-align: center;">@ViewData["Title"]</h1>


<p>
    <a asp-controller="Pacote" asp-action="CadastrarPacote" class="btn btn-primary">Cadastrar Pacote</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table custom-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome do Pacote</th>
                <th>Descrição</th>
                <th>Desconto</th>
                <th>Preço</th>
                <th>Data de Cadastro</th>
                <th>Data de Modificação</th>

                <th class="text-center">Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var pacote in Model)
            {
                <tr>
                    <td>@pacote.IdPacote</td>
                    <td>@pacote.Nome</td>
                    <td>@pacote.Descricao</td>
                    <td>@pacote.Desconto %</td>
                    <td>@pacote.Preco</td>
                    <td>@pacote.DataCadastro</td>

                    @if (pacote.DataCadastro == pacote.DataAtualizacao)
                    {
                        <td class="alert-info">Não foi modificado</td>
                    }

                    else
                    {
                        <td>@pacote.DataAtualizacao</td>
                    }

                    <td class="text-center">
                        <a asp-controller="Pacote" asp-action="EditarPacote" asp-route-id="@pacote.IdPacote" class="btn btn-sm btn-warning"><img style="max-width:20px;" src="~/image/editar.png" /></a>
                        <span>|</span>
                        <a asp-controller="Pacote" asp-action="ExcluirPacote" asp-route-id="@pacote.IdPacote"
                           onclick="return confirm('Deseja realmente Excluir este pacote?')" class="btn btn-sm btn-danger"><img style="max-width:20px;" src="~/image/lixeira.png" /></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nenhum pacote cadastrado.</p>
}