@model MaisonEcommerce.Models.Pacote;
<link href="~/css/EditFu.css" rel="stylesheet" />
<h1 class="titulo">Editar Pacote</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="EditarPacote" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input type="hidden" asp-for="IdPacote" required class="form-control" />
                <span asp-validation-for="IdPacote" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" oninput="texto(this)" required class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" oninput="texto(this)" required class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Desconto" class="control-label"></label>
                
                <select asp-for="Desconto">
                    <option value="10">10%</option>
                    <option value="20">20%</option>
                    <option value="30">30%</option>
                    <option value="40">40%</option>
                    <option value="50">50%</option>
                </select>

                <span asp-validation-for="Desconto" class="text-danger"></span>
            </div>

           <div class="btn-group">
                <input type="submit" value="Alterar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-success">Voltar</a>
            </div>
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>