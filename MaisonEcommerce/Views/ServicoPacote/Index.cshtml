@model IEnumerable<MaisonEcommerce.Models.Servico_Pacote>

<p>
    <a asp-controller="ServPacote" asp-action="CadastrarServPacote" class="btn btn-primary">Adicionar serviços nos pacotes</a>
</p>

<table class="table custom-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdServicoPacote)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NomeServico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NomePacote)
            </th>

            <th class="text-center">Ação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdServicoPacote)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NomeServico)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NomePacote)
                </td>
                <td class="text-center">
                    <a asp-controller="ServPacote" asp-action="EditarServPacote" asp-route-id="@item.IdServicoPacote" class="btn btn-sm btn-warning">Editar</a>
                    <span>|</span>
                    <a asp-controller="ServPacote" asp-action="ExcluirServPacote" asp-route-id="@item.IdServicoPacote"
                       onclick="return confirm('Deseja realmente Excluir este Serviço do pacote?')" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>