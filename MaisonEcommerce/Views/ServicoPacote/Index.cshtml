@model IEnumerable<MaisonEcommerce.Models.Servico_Pacote>

<p>
    <a asp-controller="ServicoPacote" asp-action="CadastrarServicoPacote" class="btn btn-primary">Cadastrar Servico Pacote</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

<table class="table custom-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdServicoPacote)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.IdServico)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.IdPacote)
            </th>

            <th class="text-center">Ação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.IdServicoPacote)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.IdServico)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.IdPacote)
                </td>

                <td class="text-center">
                    <a asp-controller="ServicoPacote" asp-action="EditarServicoPacote" asp-route-id="@item.IdServicoPacote" class="btn btn-sm btn-warning">Editar</a>
                    <span>|</span>
                    <a asp-controller="ServicoPacote" asp-action="ExcluirServicoPacote" asp-route-id="@item.IdServicoPacote"
                       onclick="return confirm('Deseja realmente Excluir este ServicoPacote?')" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>