@model MaisonEcommerce.Models.Cliente;
<link href="~/css/Cadastro.css" rel="stylesheet" />

<h1 class="titulo-cli">Cadastrar Cliente</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        @if (TempData["Mensagem"] != null)
        {
            <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
        }
        <form asp-action="CadastrarCliente">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" required oninput="texto(this)" maxlength="50" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <label asp-for="CPF" class="control-label"></label>
                <input asp-for="CPF" required oninput="cpf(this)" id="txtCpf" maxlength="14" class="form-control" />
                <span asp-validation-for="CPF" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Telefone" class="control-label"></label>
                <input type="tel" min="13" maxlength="13" required value="(" oninput="telefone(this)" asp-for="Telefone" class="form-control" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Idade" class="control-label"></label>
                <input asp-for="Idade" type="text" required oninput="numero(this)" maxlength="2" class="form-control" />
                <span asp-validation-for="Idade" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Sexo" class="control-label"></label>
                <select asp-for="Sexo">
                    <option value="Feminino">Feminino</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Outro">Outro</option>
                </select>

                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Cadastrar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-controller="Cliente" asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>
<script src="~/js/validacoes.js"></script>