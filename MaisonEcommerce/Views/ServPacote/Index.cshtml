@model IEnumerable<MaisonEcommerce.Models.Servico_Pacote>

<link href="~/css/IndexSePac.css" rel="stylesheet" />


@{
    ViewData["Title"] = "Serviços em Pacotes";
}

<h1 style="font-weight: bold; text-align: center;" >@ViewData["Title"]</h1>


<p>
    <a asp-controller="ServPacote" asp-action="CadastrarServPacote" class="btn btn-primary">Adicionar serviços nos pacotes</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table custom-table">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nome do Serviço</th>
                <th>Nome do Pacote</th>
                <th>Data de Adição</th>
                <th>Data de Modificação</th>

                <th class="text-center">Ação</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var servicoPacote in Model)
            {
                <tr>
                    <td>@servicoPacote.IdServicoPacote</td>
                    <td>@servicoPacote.NomeServico</td>
                    <td>@servicoPacote.NomePacote</td>
                    <td>@servicoPacote.DataAtualizacao</td>

                    @if (servicoPacote.DataAdicao == servicoPacote.DataAtualizacao)
                    {
                        <td class="text-center alert alert-info"> Não foi Modificado </td>
                    }

                    else
                    {
                        <td>@servicoPacote.DataAdicao</td>
                    }

                    <td class="text-center">
                        <a asp-controller="ServPacote" asp-action="EditarServPacote" asp-route-id="@servicoPacote.IdServicoPacote" class="btn btn-sm btn-warning"><img style="max-width:20px;" src="~/image/editar.png" /></a>
                        <span>|</span>
                        <a asp-controller="ServPacote" asp-action="ExcluirServPacote" asp-route-id="@servicoPacote.IdServicoPacote"
                           onclick="return confirm('Deseja realmente Excluir este Serviço do pacote?')" class="btn btn-sm btn-danger"><img style="max-width:20px;" src="~/image/lixeira.png" /></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

else
{
    <p>Nenhum serviço adicionado ao(s) pacote(s).</p>
}