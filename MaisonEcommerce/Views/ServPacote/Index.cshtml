@model IEnumerable<MaisonEcommerce.Models.Servico_Pacote>

<link href="~/css/IndexSePac.css" rel="stylesheet" />


@{
    ViewData["Title"] = "Serviços em Pacotes";
}

<h1 style="font-weight: bold; text-align: center;" >@ViewData["Title"]</h1>


<p>
    <a asp-controller="ServPacote" asp-action="CadastrarServPacote" class="btn btn-primary">Adicionar serviços nos pacotes</a>
</p>

@if (TempData["Mensagem"] != null)
{
    <div class="@TempData["Classe"]">@TempData["Mensagem"]</div>
}

<table class="table custom-table">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nome do Serviço</th>
            <th>Nome do Pacote</th>

            <th class="text-center">Ação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.IdServicoPacote</td>
                <td>@a.NomeServico</td>
                <td>@a.NomePacote</td>

                <td class="text-center">
                    <a asp-controller="ServPacote" asp-action="EditarServPacote" asp-route-id="@a.IdServicoPacote" class="btn btn-sm btn-warning">Editar</a>
                    <span>|</span>
                    <a asp-controller="ServPacote" asp-action="ExcluirServPacote" asp-route-id="@a.IdServicoPacote"
                       onclick="return confirm('Deseja realmente Excluir este Serviço do pacote?')" class="btn btn-sm btn-danger">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>