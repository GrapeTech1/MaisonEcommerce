@model MaisonEcommerce.Models.Servico_Pacote;

<h1 class="titulo-pa">Adicionar Serviço no Pacote</h1>
<hr />

<div class="row">
    <div class="col-md-4">

        @if (ViewData["Mensagem"] != null)
        {
            <div class="@ViewData["Classe"]">@ViewData["Mensagem"]</div>
        }

        <form asp-action="CadastrarServPacote">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NomeServico" class="control-label">Nome do Serviço:</label>
                <select asp-for="NomeServico">

                    @if (ViewBag.servicos != null)
                    {
                        @foreach (var item in ViewBag.servicos)
                        {
                            <option value="@item.IdServico">@item.Nome</option>
                        }
                    }
                    
                </select>
            </div>

            <div class="form-group">
                <label asp-for="NomePacote" class="control-label">Nome do Pacote:</label>
                <select asp-for="NomePacote">

                    @if (ViewBag.pacotes != null)
                    {
                        @foreach (var item in ViewBag.pacotes)
                        {
                            <option value="@item.IdPacote">@item.Nome</option>
                        }
                    }
                    
                </select>
            </div>

            <div class="btn">
                <div class="form-group">
                    <input type="submit" value="Adicionar" class="btn btn-primary" />
                </div>
                <div class="form-group">
                    <a asp-action="Index" class="btn btn-success">Voltar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<style>

    
    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        background-color: #000;
        font-family: Arial, sans-serif;
        color: white;
    }

    
    .row {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    
    .col-md-4 {
        background-color: #000;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 10px #222;
        width: 100%;
        max-width: 450px;
    }

    
    .titulo-pa {
        text-align: center;
        font-size: 24px;
        margin-top: 30px;
    }

    
    .form-group {
        margin-bottom: 20px;
        display: flex;
        flex-direction: column;
    }

    label {
        margin-bottom: 5px;
        font-weight: bold;
    }

    select,
    input[type="text"],
    input[type="number"],
    input[type="submit"] {
        padding: 10px;
        border: none;
        border-radius: 6px;
        background-color: white;
        color: black;
    }

    
    .btn {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

        .btn input[type="submit"],
        .btn a {
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            border: none;
        }

    .btn-primary {
        background-color: #8B5E3C !important;
        color: white !important;
    }

    .btn-success {
        background-color: white !important;
        color: black !important;
    }

        .btn-primary:hover,
        .btn-success:hover {
            opacity: 0.85;
        }

</style>